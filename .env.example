# =============================================================================
# B2B CRM Master — this project's .env only (Laravel reads this file)
# Copy: cp .env.example .env
#
# Docker (DB_MODE=local): DB_HOST=127.0.0.1 + DB_SOCKET=/var/run/mysqld/mysqld.sock reaches host MySQL.
# Stack settings (DB_MODE, ports): B2B_CRM/.env
# =============================================================================

APP_NAME="B2B CRM Master"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8001
# Production: APP_URL=https://pro-master.guaranteeadmit.com
# Testing:    APP_URL=https://master.guaranteeadmit.com

# Master portal default admin (super-admin role = all permissions)
MASTER_DEFAULT_ADMIN_EMAIL=himmat@edysor
MASTER_DEFAULT_ADMIN_PASSWORD=himmat@edysor.in
MASTER_DEFAULT_ADMIN_NAME=Himmat

# Master portal database (users, tenants registry, permissions)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Docker (DB_MODE=local): bind-mount host socket — set in B2B_CRM/.env as COMPOSE_DB_SOCKET
# DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_DATABASE=b2b_master
DB_USERNAME=admin
DB_PASSWORD=StrongPassword123!

# EC2 → RDS: auto-resolves *.rds.amazonaws.com to IPv4 (fixes error 2002)
# DB_FORCE_IPV4=true

# API token — same value on tenant CRM as MASTER_API_TOKEN
CRM_MASTER_API_TOKEN=

# Tenant CRM URLs shown in admin header badge (Docker: set COMPOSE_TENANT_* in B2B_CRM/.env)
# Production EC2 — Laravel lives under main.*; Next lives on the apex / {slug}.*:
#   Laravel: https://main.guaranteeadmit.com  |  https://{slug}.main.guaranteeadmit.com
#   Next:    https://guaranteeadmit.com       |  https://{slug}.guaranteeadmit.com
#   Master:  https://pro-master.guaranteeadmit.com
# Testing:
#   Laravel: https://testing.guaranteeadmit.com | https://{slug}.testing.guaranteeadmit.com
#   Next:    https://next.testing.guaranteeadmit.com | https://{slug}.next.testing.guaranteeadmit.com
#   Master:  https://master.guaranteeadmit.com
#   TENANT_BASE_DOMAIN=testing.guaranteeadmit.com
# Same code on both servers — only TENANT_BASE_DOMAIN / APP_URL change.
TENANT_BASE_DOMAIN=main.guaranteeadmit.com
TENANT_URL_SCHEME=https
# Local dev only:
# TENANT_BASE_DOMAIN=localhost
# TENANT_URL_SCHEME=http
# TENANT_CRM_PORT=8000
TENANT_BASE_DOMAIN_PRODUCTION=main.guaranteeadmit.com

# Custom domain setup hints + Cloudflare A record target (public CRM server IP, not 127.0.0.1)
CUSTOM_DOMAIN_SERVER_IP=
CUSTOM_DOMAIN_CNAME_TARGET=
CUSTOM_DOMAIN_SSL_EMAIL=
CUSTOM_DOMAIN_SSL_WEBROOT=/var/www/html
# DNS: Cloudflare (recommended) or Route53
DNS_PROVIDER=cloudflare
DNS_AUTO_LINK_SUBDOMAINS=true
CLOUDFLARE_API_TOKEN=
DNS_CLOUDFLARE_ZONE_ID=
DNS_CLOUDFLARE_BASE_DOMAIN=guaranteeadmit.com
DNS_CLOUDFLARE_PROXIED=false
# Optional Route53 (if DNS_PROVIDER=route53)
DNS_ROUTE53_HOSTED_ZONE_ID=
DNS_ROUTE53_BASE_DOMAIN=
DNS_ROUTE53_REGION=

# MySQL admin for provisioning (CREATE DATABASE, clone template, CREATE USER per tenant).
# On RDS: set host + user with CREATE DATABASE / CREATE USER privileges + password.
# If TENANT_DB_PASSWORD is empty, DB_PASSWORD is used automatically.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
# RDS: use your RDS master username (often NOT "root"). Must allow CREATE DATABASE from app server IP.
TENANT_DB_USERNAME=admin
TENANT_DB_PASSWORD=StrongPassword123!

# Template DB cloned into each new tenant
TENANT_TEMPLATE_DATABASE=b2b_live_database
TENANT_DATABASE_PREFIX=b2b_tenant_

# Schema clone: pdo (default, AWS RDS safe) or mysqldump
TENANT_DB_CLONE_METHOD=pdo

# After CREATE DATABASE, GRANT on each new DB (set false when b2b_tenant_%.* is pre-granted on RDS)
TENANT_DB_GRANT_ADMIN_ON_CREATE=false
# RDS without GRANT OPTION: all tenants use TENANT_DB_USERNAME (no CREATE USER per company)
TENANT_DB_SHARED_CREDENTIALS=false
TENANT_DB_ADMIN_GRANT_HOSTS=%
# Optional comma-separated overrides: TENANT_DB_GLOBAL_PRIVILEGES, TENANT_DB_DATABASE_PRIVILEGES, …

# Seconds for clone / provision job timeout (default 3000 = 50 min)
TENANT_DB_CLONE_TIMEOUT=3000

# Copy template users by id into each tenant (comma-separated). Default: 1
TENANT_SEED_USER_IDS=1

# Default CRM admin email per tenant (password is auto-generated, 16 chars, stored encrypted)
TENANT_DEFAULT_USER_EMAIL=admin@example.com
TENANT_DEFAULT_USER_NAME=Admin

# Absolute path to tenant CRM Laravel root (folder containing artisan)
# Required for "Run migrations" in admin. Example: /var/www/B2B_CRM
TENANT_CRM_PATH=

MASTER_DOMAIN=127.0.0.1:8001
MASTER_APP_URL=http://127.0.0.1:8001
# Production: MASTER_APP_URL=https://master.guaranteeadmit.com

# Live provisioning progress (tenant create → show page)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Terminal: php artisan reverb:start

# Redis + Horizon (queue dashboard at /horizon — requires Redis running)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_CONNECTION=redis
TENANT_PROVISION_QUEUE=provisioning
TENANT_PROVISION_SYNC_LOCAL=true
HORIZON_PATH=horizon
# Terminal: php artisan horizon
# Metrics graphs: php artisan schedule:work  (horizon:snapshot every 5 min)

# AWS S3 (optional — tenant folders on approve)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
